# ATL4S::V4UlT bootstrap settings.
#
# Copy to .env only for local host configuration. Do not put provider API keys
# here: provider credentials belong in the encrypted in-app vault.
#
# Linux/macOS custom data directory:
# ATL4S_DATA_DIR=/home/you/.local/share/atl4s-vault
#
# Windows example:
# ATL4S_DATA_DIR=C:\Users\you\AppData\Local\ATL4S-Vault
#
# Set to 1 when served over HTTPS (for example through Cloudflare Tunnel).
# ATL4S_SECURE_COOKIES=1
#
# run.sh / run.ps1 read these from the shell environment, not from .env.
# ATL4S_HOST=127.0.0.1
# ATL4S_PORT=8000
